 wire [2:0] funct3 = instr_i[14:12];
@@ -76,6 +80,8 @@ begin
     rs2_used_o     = 1'b0;
     rs2_fp_o       = 1'b0;
     rs3_used_o     = 1'b0;
+    rs3_fp_o       = 1'b1;
+    xif_o          = 1'b0;
