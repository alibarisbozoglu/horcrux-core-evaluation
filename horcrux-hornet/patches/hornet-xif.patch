                 output reg        valid_o,
                 output reg [31:0] pc_o,
                 output reg [31:0] instr_o,
@@ -104,7 +113,7 @@ wire leave = flush_i || (!hold_i && !busy_o);
 //operands of a multi-cycle unit, captured in its first cycle
 reg         started_q;
 reg  [31:0] cap_a, cap_b, cap_c;
-wire        start = valid_i && (div_i || fpu_i) && !started_q && !hold_i && !flush_i;
+wire        start = valid_i && (div_i || fpu_i || xif_i) && !started_q && !hold_i && !flush_i;
 
 always @(posedge clk_i or negedge rst_ni)
 begin
@@ -181,13 +190,83 @@ begin : NO_FPU
 end
 endgenerate
 
-assign busy_o = valid_i && ((div_i && !div_done) || (fpu_i && fpu_multi && !fpu_done));
+//coprocessor port: one instruction in flight. It is offered (with the operands of its first cycle) while
+//the pipeline neither holds nor flushes, so in practice an accepted instruction always retires. The result
+//is used in the cycle it arrives, or latched when EX is held by memory (the coprocessor has no
+//result_ready). Exception: a data bus
+//error of an older load/store can flush EX after the accept; that result is then dropped (drain).
+wire        xif_done;
+wire [31:0] xif_out;
+generate
+if(XIF_EN != 0)
+begin : XIF
+    reg        acc_q, res_q_valid, drain_q;
+    reg [31:0] res_q;
+    wire issue  = valid_i && xif_i && !acc_q && !drain_q && !hold_i && !flush_i;
+    wire acc    = issue && xif_issue_ready_i;
+    wire result = (acc_q || acc) && xif_result_valid_i && !drain_q;
+
+    always @(posedge clk_i or negedge rst_ni)
+    begin
+        if(!rst_ni)
+        begin
+            {acc_q, res_q_valid, drain_q} <= 3'b0;
+            res_q <= 32'b0;
+        end
+        else
+        begin
+            if(drain_q && xif_result_valid_i)
+                drain_q <= 1'b0;
+            if(leave)
+            begin
+                {acc_q, res_q_valid} <= 2'b0;
+                if(flush_i && (acc_q || acc) && !res_q_valid && !result)
+                    drain_q <= 1'b1;
+            end
+            else
+            begin
+                if(acc)
+                    acc_q <= 1'b1;
+                if(result)
+                begin
+                    res_q_valid <= 1'b1;
+                    res_q <= xif_result_data_i;
+                end
+            end
+        end
+    end
+
+    assign xif_issue_valid_o = issue;
+    assign xif_issue_instr_o = instr_i;
+    assign xif_issue_rs1_o   = use_a;
+    assign xif_issue_rs2_o   = use_b;
+    assign xif_issue_rs3_o   = use_c;
+    //the result pulse finishes the instruction in the same cycle (issue does not depend on busy_o: no loop)
+    assign xif_done = res_q_valid || result;
+    assign xif_out  = res_q_valid ? res_q : xif_result_data_i;
+end
+else
+begin : NO_XIF
+    assign xif_issue_valid_o = 1'b0;
+    assign xif_issue_instr_o = 32'b0;
+    assign xif_issue_rs1_o   = 32'b0;
+    assign xif_issue_rs2_o   = 32'b0;
+    assign xif_issue_rs3_o   = 32'b0;
+    assign xif_done = 1'b1;
+    assign xif_out  = 32'b0;
+    wire unused_xif = &{1'b0, xif_issue_ready_i, xif_result_valid_i, xif_result_data_i};
+end
+endgenerate
+
+assign busy_o = valid_i && ((div_i && !div_done) || (fpu_i && fpu_multi && !fpu_done) || (xif_i && !xif_done));
 
 reg [31:0] result;
 always @*
 begin
     if(csr_i)
         result = csr_imm_i ? imm_i : op_a; //CSR source operand
+    else if(xif_i)
+        result = xif_out;
     else
         case(res_sel_i)
             `RES_PC4: result = pc4;
