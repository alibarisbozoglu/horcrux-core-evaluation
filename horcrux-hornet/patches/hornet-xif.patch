@@ -45,6 +46,14 @@ module ex_stage #(parameter RV_M = 1, parameter RV_F = 1)
                 output     [31:0] redirect_pc_o,
                 output     [31:0] redirect_pc4_o,
 
+                //coprocessor port (XIF_EN): issue with handshake, result as a one-cycle pulse
+                output            xif_issue_valid_o,
+                input             xif_issue_ready_i,
+                output     [31:0] xif_issue_instr_o,
+                output     [31:0] xif_issue_rs1_o, xif_issue_rs2_o, xif_issue_rs3_o,
+                input             xif_result_valid_i,
