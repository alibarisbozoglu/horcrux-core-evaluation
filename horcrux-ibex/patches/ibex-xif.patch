+        if (xif_issue_valid_o & xif_issue_ready_i) begin
+          xif_issued_q <= 1'b1;
+        end
+        if (xif_issued_q & xif_result_valid_i) begin
+          xif_res_q_valid <= 1'b1;
+          xif_res_q       <= xif_result_data_i;
+        end
+      end
+    end
+  end else begin : g_no_xif
+    assign xif_insn          = 1'b0;
+    assign xif_rs3_rd        = 1'b0;
+    assign xif_done          = 1'b0;
+    assign xif_res_data      = '0;
+    assign xif_issue_valid_o = 1'b0;
+    assign xif_issue_instr_o = '0;
+    assign xif_issue_rs1_o   = '0;
+    assign xif_issue_rs2_o   = '0;
+    assign xif_issue_rs3_o   = '0;
+
+    logic unused_xif;
+    assign unused_xif = ^{xif_issue_ready_i, xif_result_valid_i, xif_result_data_i};
+  end
