+
+    assign xif_issue_valid_o = xif_insn & instr_executing & ~xif_issued_q &
+                               (~xif_rs3 | xif_rs3_q_valid);
+    assign xif_issue_instr_o = instr_rdata_i;
+    assign xif_issue_rs1_o   = rf_rdata_a_fwd;
+    assign xif_issue_rs2_o   = rf_rdata_b_fwd;
+    assign xif_issue_rs3_o   = xif_rs3_q;
+
+    assign xif_done     = xif_issued_q & (xif_result_valid_i | xif_res_q_valid);
+    assign xif_res_data = xif_res_q_valid ? xif_res_q : xif_result_data_i;
+    assign xif_clear    = ~xif_insn | instr_done;
+
+    always_ff @(posedge clk_i or negedge rst_ni) begin
+      if (!rst_ni) begin
+        xif_rs3_q_valid <= 1'b0;
+        xif_rs3_q       <= '0;
+        xif_issued_q    <= 1'b0;
+        xif_res_q_valid <= 1'b0;
+        xif_res_q       <= '0;
+      end else if (xif_clear) begin
+        xif_rs3_q_valid <= 1'b0;
+        xif_issued_q    <= 1'b0;
+        xif_res_q_valid <= 1'b0;
+      end else begin
+        if (xif_rs3_rd & instr_executing) begin
+          xif_rs3_q_valid <= 1'b1;
+          xif_rs3_q       <= rf_rdata_a_fwd;
